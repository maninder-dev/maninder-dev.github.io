# Replace <db_username> with your Atlas database user name
MONGO_URI=mongodb+srv://maninder6005_db_user:<db_password>@cluster0.xan2wom.mongodb.net/student_library?retryWrites=true&w=majority&appName=Cluster0
PORT=5000
# Fixes "querySrv ECONNREFUSED" when Node uses 127.0.0.1 as DNS on Windows
DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGINS=http://localhost:4200,http://localhost:5173

# Default admin created by `npm run seed`
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@library.com
ADMIN_PASSWORD=Admin@123
